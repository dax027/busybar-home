# The safe default uses an in-memory device and performs no network I/O.
BUSYBAR_CLIENT=fake

# Used only when BUSYBAR_CLIENT=official.
BUSYBAR_DEVICE_ADDRESS=10.0.4.20
BUSYBAR_ACCESS_TOKEN=

# Both settings are required to permit physical-device access.
BUSYBAR_ALLOW_HARDWARE=false
# 100 is required to override any currently active display owner.
BUSYBAR_DISPLAY_PRIORITY=100

# Local dashboard binding. Keep the host on loopback unless LAN access is intentional.
BUSYBAR_WEB_HOST=127.0.0.1
BUSYBAR_WEB_PORT=8765
